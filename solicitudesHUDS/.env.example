# Copiar este archivo como .env y completar los valores.

# Gmail: usar una contraseña de aplicación, no la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM="ANDES Solicitudes <tu-email@gmail.com>"

# Exchange institucional sin autenticación (alternativa):
# SMTP_HOST=smtp.example.org
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_FROM=andes@example.org